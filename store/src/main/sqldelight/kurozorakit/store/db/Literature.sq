CREATE TABLE IF NOT EXISTS LiteratureEntity (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    href TEXT NOT NULL,

    slug TEXT NOT NULL,
    title TEXT NOT NULL,
    original_title TEXT,
    synopsis TEXT,
    tagline TEXT,

    poster_json TEXT,
    banner_json TEXT,
    logo_json TEXT,
    studio TEXT,

    tv_rating_json TEXT NOT NULL,
    media_type_json TEXT NOT NULL,
    source_json TEXT NOT NULL,
    status_json TEXT NOT NULL,

    volume_count INTEGER NOT NULL,
    chapter_count INTEGER NOT NULL,
    page_count INTEGER NOT NULL,

    duration TEXT NOT NULL,
    duration_count INTEGER NOT NULL,
    duration_total TEXT NOT NULL,
    duration_total_count INTEGER NOT NULL,

    publication_season TEXT,
    publication_time TEXT,
    publication_day TEXT,
    is_nsfw INTEGER NOT NULL,
    copyright TEXT,

    started_at TEXT, -- LocalDate as ISO string
    ended_at TEXT,
    next_publication_at TEXT,

    -- External IDs
    anidb_id INTEGER,
    anilist_id INTEGER,
    anime_planet_id TEXT,
    anisearch_id INTEGER,
    kitsu_id INTEGER,
    mal_id INTEGER,

    -- Complex JSON fields
    library_json TEXT,
    genres_json TEXT,
    themes_json TEXT,
    synonym_titles_json TEXT,
    languages_json TEXT,
    country_of_origin_json TEXT,
    stats_json TEXT,
    relationships_json TEXT,

    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

selectById:
SELECT * FROM LiteratureEntity WHERE id = ?;

selectByIds:
SELECT * FROM LiteratureEntity WHERE id IN ?;

insertOrReplace:
INSERT OR REPLACE INTO LiteratureEntity VALUES ?;

deleteById:
DELETE FROM LiteratureEntity WHERE id = ?;

deleteStale:
DELETE FROM LiteratureEntity WHERE updated_at < ?;

countAll:
SELECT COUNT(*) FROM LiteratureEntity;