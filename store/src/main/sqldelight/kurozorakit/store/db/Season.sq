CREATE TABLE IF NOT EXISTS SeasonEntity (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    href TEXT NOT NULL,

    -- Attributes
    number INTEGER NOT NULL,
    title TEXT NOT NULL,
    synopsis TEXT,
    episode_count INTEGER NOT NULL,
    rating_average REAL NOT NULL,
    started_at_timestamp INTEGER,

    -- Watch Status (JSON)
    watch_status_json TEXT,

    -- Complex Fields (JSON)
    poster_json TEXT,

    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

selectById:
SELECT * FROM SeasonEntity WHERE id = ?;

-- Sezon numarasına göre sıralı getir
selectByShowId:
SELECT * FROM SeasonEntity WHERE id IN (
    -- Burada normalde bir ilişki tablosu veya JSON içindeki ID listesi kullanılır
    -- Ancak basitleştirmek için direkt ID listesi sorgusu:
    ?
) ORDER BY number ASC;

insertOrReplace:
INSERT OR REPLACE INTO SeasonEntity VALUES ?;

deleteById:
DELETE FROM SeasonEntity WHERE id = ?;

deleteStale:
DELETE FROM SeasonEntity WHERE updated_at < ?;

countAll:
SELECT COUNT(*) FROM SeasonEntity;