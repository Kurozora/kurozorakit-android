-- Show Entity Table
CREATE TABLE IF NOT EXISTS ShowEntity (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    href TEXT NOT NULL,

    slug TEXT NOT NULL,
    title TEXT NOT NULL,
    original_title TEXT,
    synopsis TEXT,
    tagline TEXT,
    video_url TEXT,

    poster_json TEXT,
    banner_json TEXT,
    logo_json TEXT,

    studio TEXT,

    tv_rating_json TEXT,
    media_type_json TEXT,
    source_json TEXT,
    status_json TEXT,

    episode_count INTEGER NOT NULL,
    season_count INTEGER NOT NULL,

    duration TEXT NOT NULL,
    duration_count INTEGER NOT NULL,
    duration_total TEXT NOT NULL,
    duration_total_count INTEGER NOT NULL,

    air_season TEXT,
    air_time TEXT,
    air_day TEXT,

    is_nsfw INTEGER NOT NULL,

    copyright TEXT,

    started_at INTEGER,
    ended_at INTEGER,
    next_broadcast_at INTEGER,

    -- External IDs
    anidb_id INTEGER,
    anilist_id INTEGER,
    anime_planet_id TEXT,
    anisearch_id INTEGER,
    imdb_id TEXT,
    kitsu_id INTEGER,
    mal_id INTEGER,
    notify_id TEXT,
    syoboi_id INTEGER,
    trakt_id INTEGER,
    tvdb_id INTEGER,
    -- JSON fields
    genres_json TEXT,
    themes_json TEXT,
    synonym_titles_json TEXT,
    languages_json TEXT,
    country_of_origin_json TEXT,
    stats_json TEXT,
    library_json TEXT,
    relationships_json TEXT,
    -- Cache metadata
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now') * 1000),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now') * 1000)
);

-- Indexes for faster queries
CREATE INDEX IF NOT EXISTS idx_show_updated_at ON ShowEntity(updated_at);

-- Get all shows
selectAll:
SELECT * FROM ShowEntity ORDER BY updated_at DESC;

-- Get show by ID
selectById:
SELECT * FROM ShowEntity WHERE id = ?;

-- Get shows by IDs
selectByIds:
SELECT * FROM ShowEntity WHERE id IN ?;

-- Insert or replace show
insertOrReplace:
INSERT OR REPLACE INTO ShowEntity(
    id, type, href, slug, title, original_title, synopsis, tagline,
    video_url, poster_json, banner_json, logo_json, studio,
    tv_rating_json, media_type_json, source_json, status_json,
    episode_count, season_count, duration, duration_count, duration_total, duration_total_count,
    air_season, air_time, air_day, is_nsfw, copyright,
    started_at, ended_at, next_broadcast_at,
    anidb_id, anilist_id, anime_planet_id, anisearch_id, imdb_id, kitsu_id, mal_id, notify_id, syoboi_id, trakt_id, tvdb_id,
    library_json,
    genres_json, themes_json, synonym_titles_json, languages_json, country_of_origin_json, stats_json, relationships_json,
    created_at, updated_at
) VALUES (
    ?, ?, ?, ?, ?, ?, ?, ?,
    ?, ?, ?, ?, ?,
    ?, ?, ?, ?,
    ?, ?, ?, ?, ?, ?,
    ?, ?, ?, ?, ?,
    ?, ?, ?,
    ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,
    ?, ?, ?,
    ?, ?,
    ?, ?, ?, ?, ?
);

-- Delete show
deleteById:
DELETE FROM ShowEntity WHERE id = ?;

-- Delete all shows
deleteAll:
DELETE FROM ShowEntity;

-- Delete stale entries (older than given timestamp)
deleteStale:
DELETE FROM ShowEntity WHERE updated_at < ?;

-- Count all shows
countAll:
SELECT COUNT(*) FROM ShowEntity;