CREATE TABLE IF NOT EXISTS GameEntity (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    href TEXT NOT NULL,

    -- Attributes
    slug TEXT NOT NULL,
    title TEXT NOT NULL,
    original_title TEXT,
    synopsis TEXT,
    tagline TEXT,
    studio TEXT,

    igdb_id INTEGER,
    igdb_slug TEXT,

    poster_json TEXT,
    banner_json TEXT,
    logo_json TEXT,

    tv_rating_json TEXT NOT NULL,
    media_type_json TEXT NOT NULL,
    source_json TEXT NOT NULL,
    status_json TEXT NOT NULL,

    edition_count INTEGER NOT NULL,

    duration TEXT NOT NULL,
    duration_count INTEGER NOT NULL,
    duration_total TEXT NOT NULL,
    duration_total_count INTEGER NOT NULL,

    publication_season TEXT,
    publication_time TEXT,
    publication_day TEXT,
    is_nsfw INTEGER NOT NULL,
    copyright TEXT,

    started_at TEXT, -- LocalDate ISO String
    ended_at TEXT,

    -- Complex Fields (JSON)
    synonym_titles_json TEXT,
    genres_json TEXT,
    themes_json TEXT,
    languages_json TEXT,
    country_of_origin_json TEXT,
    stats_json TEXT,
    library_json TEXT,
    relationships_json TEXT,

    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

selectById:
SELECT * FROM GameEntity WHERE id = ?;

selectByIds:
SELECT * FROM GameEntity WHERE id IN ?;

insertOrReplace:
INSERT OR REPLACE INTO GameEntity VALUES ?;

deleteById:
DELETE FROM GameEntity WHERE id = ?;

deleteAll:
DELETE FROM GameEntity;

deleteStale:
DELETE FROM GameEntity WHERE updated_at < ?;

countAll:
SELECT COUNT(*) FROM GameEntity;