CREATE TABLE IF NOT EXISTS PersonEntity (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    href TEXT NOT NULL,

    -- Attributes
    slug TEXT NOT NULL,
    full_name TEXT NOT NULL,
    full_given_name TEXT,
    about TEXT,
    short_description TEXT,
    age TEXT,
    birthdate_timestamp INTEGER,
    deceased_date_timestamp INTEGER,
    astrological_sign TEXT,

    -- User Generated (Mutable)
    given_rating REAL,
    given_review TEXT,

    -- Complex Fields (JSON)
    profile_json TEXT,
    alternative_names_json TEXT,
    website_urls_json TEXT,
    stats_json TEXT,
    relationships_json TEXT,

    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

selectById:
SELECT * FROM PersonEntity WHERE id = ?;

selectByIds:
SELECT * FROM PersonEntity WHERE id IN ?;

insertOrReplace:
INSERT OR REPLACE INTO PersonEntity VALUES ?;

deleteById:
DELETE FROM PersonEntity WHERE id = ?;

deleteAll:
DELETE FROM PersonEntity;

deleteStale:
DELETE FROM PersonEntity WHERE updated_at < ?;

countAll:
SELECT COUNT(*) FROM PersonEntity;