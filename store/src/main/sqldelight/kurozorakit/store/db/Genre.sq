-- Genre Entity Table
CREATE TABLE IF NOT EXISTS GenreEntity (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    href TEXT NOT NULL,

    slug TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT,

    background_color1 TEXT NOT NULL,
    background_color2 TEXT NOT NULL,
    text_color1 TEXT NOT NULL,
    text_color2 TEXT NOT NULL,

    symbol_json TEXT, -- Media object as JSON
    is_nsfw INTEGER NOT NULL, -- Boolean as 0/1

    -- Cache metadata
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now') * 1000),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now') * 1000)
);

-- Indexes
CREATE INDEX IF NOT EXISTS idx_genre_updated_at ON GenreEntity(updated_at);

-- Queries
selectAll:
SELECT * FROM GenreEntity ORDER BY name ASC;

selectById:
SELECT * FROM GenreEntity WHERE id = ?;

insertOrReplace:
INSERT OR REPLACE INTO GenreEntity(
    id, type, href, slug, name, description,
    background_color1, background_color2, text_color1, text_color2,
    symbol_json, is_nsfw, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM GenreEntity WHERE id = ?;

deleteAll:
DELETE FROM GenreEntity;

deleteStale:
DELETE FROM GenreEntity WHERE updated_at < ?;

countAll:
SELECT COUNT(*) FROM GenreEntity;