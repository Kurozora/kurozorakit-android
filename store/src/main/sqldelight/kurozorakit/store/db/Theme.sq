-- Theme Entity Table
CREATE TABLE IF NOT EXISTS ThemeEntity (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    href TEXT NOT NULL,

    slug TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT,

    background_color1 TEXT NOT NULL,
    background_color2 TEXT NOT NULL,
    text_color1 TEXT NOT NULL,
    text_color2 TEXT NOT NULL,

    symbol_json TEXT, -- Media nesnesi JSON olarak saklanır
    is_nsfw INTEGER NOT NULL, -- Boolean (0/1)

    -- Cache metadata
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now') * 1000),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now') * 1000)
);

-- Queries
selectAll:
SELECT * FROM ThemeEntity ORDER BY name ASC;

selectById:
SELECT * FROM ThemeEntity WHERE id = ?;

insertOrReplace:
INSERT OR REPLACE INTO ThemeEntity(
    id, type, href, slug, name, description,
    background_color1, background_color2, text_color1, text_color2,
    symbol_json, is_nsfw, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM ThemeEntity WHERE id = ?;

deleteAll:
DELETE FROM ThemeEntity;

deleteStale:
DELETE FROM ThemeEntity WHERE updated_at < ?;

countAll:
SELECT COUNT(*) FROM ThemeEntity;